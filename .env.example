# VIZI core base URL (e.g. https://vizi.hr)
VIZI_CORE_BASE_URL=

# Shared secret for SSO verify endpoint (Bearer token)
VIZI_SSO_SHARED_SECRET=

# Supabase (server-only; never expose service role key to client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (server-only; for reminder emails)
RESEND_API_KEY=
REMINDERS_FROM_EMAIL=no-reply@vizi.hr
